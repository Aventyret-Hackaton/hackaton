# wordpress — the cms role and its backing services.
CMS_URL=https://cms.${RIG_HOST_BASE}.test
CMS_URL_INTERNAL=http://${RIG_HOST_BASE}-cms:8080

DB_HOST=${RIG_HOST_BASE}-db
DB_PORT=3306
DB_NAME=__SITE_DB__
DB_USER=root
DB_PASSWORD=password

REDIS_HOST=${RIG_HOST_BASE}-redis
REDIS_PORT=6379
REDIS_URL=redis://${RIG_HOST_BASE}-redis:6379
