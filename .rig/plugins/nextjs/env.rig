# nextjs — the www role. The ENV_* values are shared across the environment and live
# here because every site with a frontend has the www role; a site with cms but
# without www does not exist, and if one appears it declares them itself.
ENV_NAME=development
# Shared cookie domain for the environment's services (rig://env/cookie-domain).
# Locally the parent domain of the www./cms. hosts; on Cloud Run the facet resolves
# to the service's own host (run.app has no shared cookie domain).
ENV_COOKIE_DOMAIN=${RIG_HOST_BASE}.test

WWW_URL=https://www.${RIG_HOST_BASE}.test
WWW_URL_INTERNAL=http://${RIG_HOST_BASE}-www:8080
